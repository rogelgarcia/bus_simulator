# Shared worktree folders (symlinked from main)
/assets
!/assets/
/assets/*
!/assets/public/
/assets/public/*
!/assets/public/pbr/
/assets/public/pbr/**
!/assets/public/pbr/*/
!/assets/public/pbr/_catalog_index.js
!/assets/public/pbr/*/pbr.material.config.js
!/assets/public/pbr/*/pbr.material.correction.config.js
!/assets/public/pbr/*/pbr.landscape.config.json
# Generated landscape cache: local only, never tracked or distributed through Git/LFS. Keep this the last
# assets rule and never re-include anything beneath it (tools/bake_landscape/README.md, "Local landscape cache").
/assets/public/landscape/
/tools/baking/blender.local.json
/downloads
/docs

*.zip

