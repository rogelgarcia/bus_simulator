node_modules/

# OS files
.DS_Store
Thumbs.db

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# Build files
dist/
build/

PROJECT_RULES.local.md

# Test artifacts (generated outputs only)
tests/artifacts/
